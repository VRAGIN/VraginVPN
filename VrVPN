import Foundation
import NetworkExtension
import Combine

enum TrafficMode: String, Codable {
    case full            // весь трафик через VPN
    case whitelistOnly   // через VPN идут только адреса из списка
    case blacklist       // через VPN идёт всё, КРОМЕ списка
}

struct VPNConfig: Codable {
    var endpoint: String = ""
    var serverPublicKey: String = ""
    var clientPrivateKey: String = ""
    var whitelist: [String] = []
    var mode: TrafficMode = .full
    var autoPickLowestPing: Bool = true
    var mtu: Int = 1420
}

/// Управляет NETunnelProviderManager: создание/обновление профиля,
/// подключение/отключение, чтение статуса.
final class VPNManager: ObservableObject {
    static let shared = VPNManager()

    @Published var status: NEVPNStatus = .disconnected
    @Published var pingMs: Int? = nil
    @Published var config: VPNConfig = VPNConfig() {
        didSet { saveConfig() }
    }

    private var manager: NETunnelProviderManager?
    private let bundleId = "com.yourcompany.MyVPNClient.PacketTunnel"
    private let defaultsKey = "vpn.config"

    init() {
        loadConfig()
        NotificationCenter.default.addObserver(
            self, selector: #selector(statusChanged),
            name: .NEVPNStatusDidChange, object: nil
        )
    }

    func loadStatus() {
        NETunnelProviderManager.loadAllFromPreferences { [weak self] managers, _ in
            guard let self = self else { return }
            if let existing = managers?.first {
                self.manager = existing
                DispatchQueue.main.async {
                    self.status = existing.connection.status
                }
            }
        }
    }

    func toggle() {
        switch status {
        case .connected, .connecting:
            manager?.connection.stopVPNTunnel()
        default:
            connect()
        }
    }

    private func connect() {
        let tunnelManager = manager ?? NETunnelProviderManager()

        let proto = NETunnelProviderProtocol()
        proto.providerBundleIdentifier = bundleId
        proto.serverAddress = config.endpoint
        // Приватные данные передаются в extension через providerConfiguration,
        // на реальном проекте — лучше через Keychain, а не как plain dict.
        proto.providerConfiguration = [
            "serverPublicKey": config.serverPublicKey,
            "clientPrivateKey": config.clientPrivateKey,
            "mode": config.mode.rawValue,
            "whitelist": config.whitelist,
            "mtu": config.mtu
        ]

        tunnelManager.protocolConfiguration = proto
        tunnelManager.localizedDescription = "Мой VPN"
        tunnelManager.isEnabled = true

        tunnelManager.saveToPreferences { [weak self] error in
            guard error == nil else { return }
            tunnelManager.loadFromPreferences { error in
                guard error == nil else { return }
                self?.manager = tunnelManager
                try? tunnelManager.connection.startVPNTunnel()
            }
        }
    }

    @objc private func statusChanged() {
        guard let conn = manager?.connection else { return }
        DispatchQueue.main.async { self.status = conn.status }
    }

    private func saveConfig() {
        if let data = try? JSONEncoder().encode(config) {
            UserDefaults.standard.set(data, forKey: defaultsKey)
        }
    }

    private func loadConfig() {
        if let data = UserDefaults.standard.data(forKey: defaultsKey),
           let decoded = try? JSONDecoder().decode(VPNConfig.self, from: data) {
            config = decoded
        }
    }
}
