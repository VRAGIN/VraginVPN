import NetworkExtension
import WireGuardKit // добавляется через Swift Package: https://github.com/WireGuard/wireguard-apple

/// Экстеншен, который реально поднимает туннель.
/// Работает в отдельном процессе от основного приложения (требование Apple).
class PacketTunnelProvider: NEPacketTunnelProvider {

    private var adapter: WireGuardAdapter?

    override func startTunnel(options: [String: NSObject]?, completionHandler: @escaping (Error?) -> Void) {
        guard let proto = protocolConfiguration as? NETunnelProviderProtocol,
              let cfg = proto.providerConfiguration,
              let serverPublicKey = cfg["serverPublicKey"] as? String,
              let clientPrivateKey = cfg["clientPrivateKey"] as? String,
              let endpoint = proto.serverAddress,
              let modeRaw = cfg["mode"] as? String,
              let mode = TrafficMode(rawValue: modeRaw)
        else {
            completionHandler(NSError(domain: "MyVPN", code: 1, userInfo: [NSLocalizedDescriptionKey: "Некорректная конфигурация"]))
            return
        }

        let whitelist = cfg["whitelist"] as? [String] ?? []
        let mtu = cfg["mtu"] as? Int ?? 1420

        let wgConfig = buildWireGuardConfig(
            endpoint: endpoint,
            serverPublicKey: serverPublicKey,
            clientPrivateKey: clientPrivateKey,
            mode: mode,
            whitelist: whitelist,
            mtu: mtu
        )

        let adapter = WireGuardAdapter(with: self) { logLevel, message in
            NSLog("[WireGuard] \(message)")
        }
        self.adapter = adapter

        adapter.start(tunnelConfiguration: wgConfig) { error in
            completionHandler(error)
        }
    }

    override func stopTunnel(with reason: NEProviderStopReason, completionHandler: @escaping () -> Void) {
        adapter?.stop { _ in completionHandler() }
    }

    override func handleAppMessage(_ messageData: Data, completionHandler: ((Data?) -> Void)?) {
        // Канал для обмена сообщениями с основным приложением
        // (например, запрос текущего пинга/статуса соединения).
        completionHandler?(nil)
    }

    /// Собирает конфигурацию WireGuard: маршруты (routes) определяют,
    /// какой трафик реально идёт через туннель.
    /// - full: маршрут 0.0.0.0/0 — весь трафик
    /// - whitelistOnly: маршруты только на адреса из списка
    /// - blacklist: маршрут 0.0.0.0/0, но с excludedRoutes для списка
    private func buildWireGuardConfig(
        endpoint: String,
        serverPublicKey: String,
        clientPrivateKey: String,
        mode: TrafficMode,
        whitelist: [String],
        mtu: Int
    ) -> TunnelConfiguration {

        var allowedIPs: [IPAddressRange] = []
        switch mode {
        case .full:
            allowedIPs = [IPAddressRange(from: "0.0.0.0/0")!, IPAddressRange(from: "::/0")!]
        case .whitelistOnly:
            allowedIPs = whitelist.compactMap { IPAddressRange(from: $0) }
        case .blacklist:
            // WireGuard сам по себе не умеет "исключить" IP из allowedIPs напрямую —
            // на практике для blacklist-режима резолвим домены в IP и добавляем
            // отдельные /32 маршруты в allowedIPs НЕ включая их, а вместо этого
            // используем NEPacketTunnelNetworkSettings.excludedRoutes ниже.
            allowedIPs = [IPAddressRange(from: "0.0.0.0/0")!, IPAddressRange(from: "::/0")!]
        }

        let peer = PeerConfiguration(publicKey: PublicKey(base64Key: serverPublicKey)!)
        var mutablePeer = peer
        mutablePeer.endpoint = Endpoint(from: endpoint)
        mutablePeer.allowedIPs = allowedIPs
        mutablePeer.persistentKeepAlive = 25 // держим NAT открытым — важно для низкого пинга на переподключениях

        var interface = InterfaceConfiguration(privateKey: PrivateKey(base64Key: clientPrivateKey)!)
        interface.mtu = UInt16(mtu)

        return TunnelConfiguration(name: "MyVPN", interface: interface, peers: [mutablePeer])
    }
}
