import SwiftUI
import NetworkExtension

struct ContentView: View {
    @StateObject private var vpn = VPNManager.shared
    @State private var newRule: String = ""

    var body: some View {
        NavigationView {
            Form {
                Section("Статус") {
                    HStack {
                        Circle()
                            .fill(vpn.status == .connected ? Color.green : Color.gray)
                            .frame(width: 10, height: 10)
                        Text(statusText)
                        Spacer()
                        if vpn.status == .connected {
                            Text(vpn.pingMs != nil ? "\(vpn.pingMs!) ms" : "—")
                                .foregroundColor(.secondary)
                        }
                    }
                    Button(vpn.status == .connected ? "Отключить" : "Подключить") {
                        vpn.toggle()
                    }
                }

                Section("Сервер") {
                    TextField("Адрес сервера (endpoint)", text: $vpn.config.endpoint)
                        .keyboardType(.URL)
                        .autocapitalization(.none)
                    TextField("Публичный ключ сервера", text: $vpn.config.serverPublicKey)
                        .autocapitalization(.none)
                    TextField("Приватный ключ клиента", text: $vpn.config.clientPrivateKey)
                        .autocapitalization(.none)
                }

                Section("Режим трафика") {
                    Picker("Режим", selection: $vpn.config.mode) {
                        Text("Весь трафик через VPN").tag(TrafficMode.full)
                        Text("Только белый список").tag(TrafficMode.whitelistOnly)
                        Text("Всё, кроме чёрного списка").tag(TrafficMode.blacklist)
                    }
                }

                if vpn.config.mode != .full {
                    Section("Белый список (домены/IP)") {
                        ForEach(vpn.config.whitelist, id: \.self) { rule in
                            Text(rule)
                        }
                        .onDelete { vpn.config.whitelist.remove(atOffsets: $0) }

                        HStack {
                            TextField("example.com или 10.0.0.0/24", text: $newRule)
                                .autocapitalization(.none)
                            Button("Добавить") {
                                guard !newRule.isEmpty else { return }
                                vpn.config.whitelist.append(newRule)
                                newRule = ""
                            }
                        }
                    }
                }
                Section("Производительность") {
                    Toggle("Автовыбор ближайшего сервера по пингу", isOn: $vpn.config.autoPickLowestPing)
                    Stepper("MTU: \(vpn.config.mtu)", value: $vpn.config.mtu, in: 1200...1500, step: 20)
                }
            }
            .navigationTitle("Мой VPN")
        }
        .onAppear { vpn.loadStatus() }
    }

    private var statusText: String {
        switch vpn.status {
        case .connected: return "Подключено"
        case .connecting: return "Подключение…"
        case .disconnected: return "Отключено"
        case .invalid, .reasserting, .disconnecting: return "…"
        @unknown default: return "—"
        }
    }
}
